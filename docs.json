{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Galvant",
  "colors": {
    "primary": "#E16808",
    "light": "#E16808",
    "dark": "#3B2A47"
  },
  "background": {
    "color": {
      "light": "#F7F2E8"
    }
  },
  "fonts": {
    "family": "Poppins"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": ["index"]
      },
      {
        "group": "Chat",
        "pages": [
          {
            "group": "Ask questions with Scout",
            "root": "chat/ask-questions",
            "expanded": true,
            "directory": "card",
            "pages": [
              "chat/ask-questions/tables-and-charts",
              "chat/ask-questions/agent-trace-and-logic",
              "chat/ask-questions/give-feedback"
            ]
          },
          "chat/files",
          "chat/workflows",
          "chat/conversations"
        ]
      },
      {
        "group": "Dashboards",
        "pages": [
          "dashboards/quickstart",
          "dashboards/use-dash",
          "dashboards/variables",
          {
            "group": "Cards and visualizations",
            "expanded": true,
            "pages": [
              "dashboards/cards/tables",
              "dashboards/cards/charts",
              "dashboards/cards/numbers-and-gauges"
            ]
          },
          "dashboards/sharing",
          "dashboards/reports"
        ]
      },
      {
        "group": "Help",
        "pages": ["help/troubleshooting"]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://galvant.ai"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/galvant",
      "website": "https://galvant.ai"
    }
  }
}
